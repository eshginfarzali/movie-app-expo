{
  "expo": {
    "name": "Movie App",
    "slug": "movie-app-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "movieapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
